{
  "events": [
    {
      "id": "old_man_intro",
      "title": "長老との出会い",
      "plot": "村の入り口で、物知りな長老が旅人に声をかける。",
      "villagerName": "長老",
      "nodes": [
        {
          "id": "start",
          "type": "start",
          "content": "「おお、見かけない顔じゃな。わしはこの村の長老じゃ。何か困りごとかね？」",
          "nextStepId": "choice_1"
        },
        {
          "id": "choice_1",
          "type": "choice",
          "content": "どう答える？",
          "choices": [
            {
              "text": "「道に迷ってしまいました」",
              "nextStepId": "story_lost"
            },
            {
              "text": "「この村について教えてください」",
              "nextStepId": "story_about_village"
            },
            {
              "text": "「いえ、別に...」",
              "nextStepId": "end_nothing"
            }
          ]
        },
        {
          "id": "story_lost",
          "type": "story",
          "content": "「そうか、それは難儀なことじゃ。この村はずれの森は迷いやすいからのう。少し休んでいくといい。」",
          "nextStepId": "end_rest"
        },
        {
          "id": "story_about_village",
          "type": "story",
          "content": "「この村は古くから竜の伝説が伝わっておってな...（長話が続く）」",
          "nextStepId": "end_listen"
        },
        {
          "id": "end_nothing",
          "type": "end",
          "content": "「そうか。まあ、何かあればまた声をかけるんじゃな。」"
        },
        {
          "id": "end_rest",
          "type": "end",
          "content": "長老の厚意に甘え、あなたは少し休むことにした。"
        },
        {
          "id": "end_listen",
          "type": "end",
          "content": "あなたは村の伝説について詳しくなった。"
        }
      ]
    },
    {
      "id": "potion_quest",
      "title": "薬草探しの依頼",
      "plot": "薬屋の主人が、貴重な薬草が足りずに困っている。",
      "villagerName": "薬屋",
      "requiredFlag": "MET_ELDER",
      "nodes": [
        {
          "id": "start_quest",
          "type": "start",
          "content": "「ああ、旅の方。ちょうどいいところに。実は薬の材料が切れてしまってね。森にしか生えない『月光草』を取ってきてはくれんだろうか？」",
          "setFlag": "QUEST_POTION_ACCEPTED",
          "nextStepId": "choice_quest"
        },
        {
          "id": "choice_quest",
          "type": "choice",
          "content": "依頼を受ける？",
          "choices": [
            {
              "text": "引き受ける",
              "nextStepId": "story_accepted"
            },
            {
              "text": "断る",
              "nextStepId": "end_declined"
            }
          ]
        },
        {
          "id": "story_accepted",
          "type": "story",
          "content": "「本当かい！助かるよ。これが月光草の見本だ。森の奥、月明かりが差す場所に咲いているという。気をつけてな。」",
          "nextStepId": "end_accepted"
        },
        {
            "id": "end_declined",
            "type": "end",
            "content": "「そうか...残念だ。また気が向いたら頼むよ。」"
        },
        {
            "id": "end_accepted",
            "type": "end",
            "content": "あなたは薬草探しの依頼を引き受けた。"
        }
      ]
    }
  ]
}
