{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "type": "object",
      "description": "Represents a user's public profile.",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        }
      },
      "required": ["displayName", "email"]
    },
    "AdminUser": {
      "title": "Admin User",
      "type": "object",
      "description": "Represents a user with administrative privileges.",
      "properties": {
        "isAdmin": {
          "type": "boolean",
          "description": "Whether the user is an administrator."
        }
      },
      "required": ["isAdmin"]
    },
    "PlaytestSave": {
      "title": "Playtest Save",
      "type": "object",
      "description": "Represents a user's saved playtest session.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user this save belongs to."
        },
        "mapId": {
          "type": "string",
          "description": "The ID of the map the user was on."
        },
        "roomId": {
          "type": "string",
          "description": "The ID of the room the user was in, if any."
        },
        "positionX": {
          "type": "number",
          "description": "Character's X position."
        },
        "positionY": {
          "type": "number",
          "description": "Character's Y position."
        },
        "gold": {
          "type": "number",
          "description": "The player's current amount of gold."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last save."
        },
        "inventory": {
          "type": "array",
          "description": "The player's inventory.",
          "items": {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              }
            },
            "required": ["itemId", "quantity"]
          }
        },
        "collectedObjectIds": {
          "type": "array",
          "description": "A list of unique object IDs that the player has collected from the map.",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "type": "array",
          "description": "A list of flags the player has acquired during events.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["userId", "mapId", "positionX", "positionY", "updatedAt"]
    },
    "EventFlow": {
      "title": "Event Flow",
      "type": "object",
      "description": "Defines the structure of a game event.",
      "properties": {
        "title": {
          "type": "string"
        },
        "plot": {
          "type": "string"
        },
        "villagerId": {
          "type": "string"
        },
        "villagerName": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "requiredFlag": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/entities/EventNode"
          }
        }
      },
      "required": ["title", "nodes"]
    },
    "EventNode": {
      "title": "Event Node",
      "type": "object",
      "description": "A single scene or step within an Event Flow.",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["start", "story", "choice", "reward", "end"]
        },
        "content": {
          "type": "string"
        },
        "setFlag": {
          "type": "string"
        },
        "nextStepId": {
          "type": "string"
        },
        "requiredFlag": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/entities/Choice"
          }
        },
        "reward": {
          "$ref": "#/entities/Reward"
        }
      },
      "required": ["id", "type", "content"]
    },
    "Choice": {
      "title": "Choice",
      "type": "object",
      "description": "A player choice within a choice node.",
      "properties": {
        "text": {
          "type": "string"
        },
        "nextStepId": {
          "type": "string"
        },
        "requiredItemId": {
          "type": "string"
        },
        "lockedText": {
          "type": "string"
        }
      },
      "required": ["text", "nextStepId"]
    },
    "Reward": {
      "title": "Reward",
      "type": "object",
      "description": "A reward given to the player.",
      "properties": {
        "itemId": {
          "type": "string"
        },
        "itemName": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public user profile information."
    },
    "/admin/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Stores administrative status for users. If a document exists for a userId, that user is considered an admin."
    },
    "/playtestSaves/{userId}": {
      "schema": {
        "$ref": "#/entities/PlaytestSave"
      },
      "description": "Stores the playtest save data for a specific user. The document ID is the user's UID."
    },
    "/eventFlows/{eventFlowId}": {
      "schema": {
        "$ref": "#/entities/EventFlow"
      },
      "description": "Stores event flow data for the game."
    }
  }
}
